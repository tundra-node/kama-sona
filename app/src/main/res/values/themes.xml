<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.KamaSona" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorPrimaryVariant">@color/accentDim</item>
        <item name="colorOnPrimary">@color/bg</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:textColorPrimary">@color/textPrimary</item>
        <item name="android:textColorSecondary">@color/textSecondary</item>
        <!-- toki pona is case-sensitive-looking on the buttons; stop Material shouting -->
        <item name="textAllCaps">false</item>
        <item name="android:textAllCaps">false</item>
        <item name="bottomNavigationStyle">@style/Widget.MaterialComponents.BottomNavigationView</item>
    </style>
</resources>
